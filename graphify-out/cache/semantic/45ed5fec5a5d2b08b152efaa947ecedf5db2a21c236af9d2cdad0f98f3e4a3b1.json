9_ai_grounded_context_design_quota_digest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_19_ai_grounded_context_design_spec", "target": "specs_2026_08_19_ai_grounded_context_design_catalog_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_19_ai_grounded_context_design_spec", "target": "specs_2026_08_19_ai_grounded_context_design_client_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_19_ai_grounded_context_design_spec", "target": "specs_2026_08_19_ai_grounded_context_design_trusted_source_sanitization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_19_ai_grounded_context_design_spec", "target": "specs_2026_08_19_ai_grounded_context_design_graceful_degradation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_19_ai_grounded_context_design_spec", "target": "specs_2026_08_19_ai_grounded_context_design_guard_trip_counter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_19_ai_grounded_context_design_spec", "target": "specs_2026_08_19_ai_grounded_context_design_history_limit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": null, "weight": 1.0}, {"source": "services_ai_context_build_context", "target": "specs_2026_08_19_ai_grounded_context_design_prompt_injection_defence", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": "\u0413\u043e\u043b\u043e\u0432\u043d\u0438\u0439 \u0456\u043d\u0432\u0430\u0440\u0456\u0430\u043d\u0442", "weight": 1.0}, {"source": "services_ai_context__clean", "target": "specs_2026_08_19_ai_grounded_context_design_trusted_source_sanitization", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": "\u0421\u0430\u043d\u0456\u0442\u0438\u0437\u0430\u0446\u0456\u044f \u0434\u043e\u0432\u0456\u0440\u0435\u043d\u043e\u0433\u043e \u0434\u0436\u0435\u0440\u0435\u043b\u0430", "weight": 1.0}, {"source": "services_ai_context_catalog", "target": "specs_2026_08_19_ai_grounded_context_design_catalog_cache", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": "\u041c\u043e\u0434\u0443\u043b\u0456", "weight": 1.0}, {"source": "services_ai_context_for_user", "target": "specs_2026_08_19_ai_grounded_context_design_client_isolation", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-19-ai-grounded-context-design.md", "source_location": "\u0406\u0437\u043e\u043b\u044f\u0446\u0456\u044f \u043a\u043b\u0456\u0454\u043d\u0442\u0456\u0432", "weight": 1.0}, {"source": "services_ai_cont